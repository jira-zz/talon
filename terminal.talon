tag: terminal 
-
night run: mc
night run root: sudo mc
sudo: sudo
night up: key(left)
night down: key(right)
night search: key(alt-s)
much window next: key(ctrl-a-n)
much window previous: key(ctrl-a-p)
much window new: key(ctrl-a-c)
much window close: key(ctrl-a-&)
much detach: key(ctrl-a-d)
much window numb <number_small>$: key('ctrl-a-{number_small}')
show log post: insert("less /var/log/pgsql\n")
page next: key(space)
page previous: key(ctrl-b)
line bottom: key(G)
page search: key(/)
search next: key(n)
search previous: key(shift-n)