app: firefox
-
tab down: key(K)
tab up: key(J)
conty right: key(alt-right)
conty left: key(alt-left)
conty <number_small>$: key('alt-{number_small}')
berry search: key(shift-f3)
berry panel top: key(ctrl-p-up)
berry panel bottom: key(ctrl-p-down)
panel scroll up: key(ctrl-alt-up)
panel scroll down: key(ctrl-alt-down)
tabs close down: key(alt-ctrl-d)
tabs close up: key(alt-ctrl-w)